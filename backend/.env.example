# Membra Money Protocol — Backend Environment Configuration

# Database
DATABASE_URL=postgresql://membra:membra_dev@localhost:5432/membramoney

# Redis (nonce store, caching)
REDIS_URL=redis://localhost:6379/0

# JWT Secrets (generate strong random values for production)
JWT_SECRET=your-jwt-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=EXNLzDxRPN81NtxZKzNBKweG93R9FWUq8gfGoFGzxYYw

# CORS
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Observability
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Feature flags
DEVNET=true
WALLET_MOCK=false
