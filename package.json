    "@types/mocha": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "chai": "^4.3.4",
    "eslint": "^8.0.0",
    "mocha": "^9.0.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.3.5"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0"
  }
}
