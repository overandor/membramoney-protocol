{
  "name": "membramoney-protocol",
  "version": "0.1.0-devnet",
  "description": "Membra Money Protocol — Experimental Devnet-First Solana Protocol",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "test": "anchor test",
