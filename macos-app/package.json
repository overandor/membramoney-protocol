{
  "name": "membramoney-appraiser",
  "version": "1.0.0",
  "description": "Machine Appraisal — dollar value of every file, tracked hourly with Merkle trees",
  "main": "electron.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5174 && electron .\"",
    "build": "vite build && electron-builder --mac dmg",
    "build:dir": "vite build && electron-builder --mac dir",
    "vite": "vite",
    "electron": "electron ."
  },
  "build": {
    "appId": "com.membramoney.appraiser",
    "productName": "Membra Appraiser",
    "directories": { "output": "dist-app" },
    "files": [
      "electron.cjs",
      "preload.cjs",
      "dist/**/*"
    ],
    "extraResources": [],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "assets/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Membra Appraiser",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "wait-on": "^8.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
