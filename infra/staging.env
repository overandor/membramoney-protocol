# Staging Environment Configuration
ENV=staging
DEBUG=false
BACKEND_URL=https://staging-api.membramoney.dev

# Database (RDS staging instance)
DATABASE_URL=postgresql+asyncpg://membra:****@staging-db.****.us-east-1.rds.amazonaws.com:5432/membramoney

# Redis (ElastiCache)
REDIS_URL=redis://staging-redis.****.cache.amazonaws.com:6379/0

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
ANCHOR_PROGRAM_ID=EXNLzDxRPN81NtxZKzNBKweG93R9FWUq8gfGoFGzxYYw

# Security
JWT_SECRET=****
HMAC_PEPPER=****
CLAIM_SALT=****

# CORS
CORS_ALLOWED_ORIGINS=https://staging.membramoney.dev,https://staging-api.membramoney.dev

# Feature flags
ENABLE_RATE_LIMITING=true
ENABLE_AUDIT_EVENTS=true
ENABLE_REDIS_CACHE=true
ENABLE_METRICS=true
ENABLE_SENTRY=true
ENABLE_CIRCUIT_BREAKER=true

# Sentry
SENTRY_DSN=https://****@sentry.io/****

# Logging
LOG_LEVEL=info
STRUCTLOG=true
