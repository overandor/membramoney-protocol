{
  "name": "membra-filelife",
  "version": "1.0.0",
  "description": "MEMBRA FileLife Collateral Registry — bank-grade file passport for every financial document",
  "main": "electron.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5175 && electron .\"",
    "build": "vite build && electron-builder --mac dmg",
    "build:dir": "vite build && electron-builder --mac dir",
    "vite": "vite",
    "electron": "electron ."
  },
  "build": {
    "appId": "com.membramoney.filelife",
    "productName": "MEMBRA FileLife",
    "directories": { "output": "dist-app" },
    "files": ["electron.cjs", "preload.cjs", "dist/**/*"],
    "mac": {
      "category": "public.app-category.finance",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "MEMBRA FileLife Registry",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@octokit/rest": "^21.0.0",
    "@solana/web3.js": "^1.95.0",
    "bwip-js": "^4.0.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "wait-on": "^8.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
